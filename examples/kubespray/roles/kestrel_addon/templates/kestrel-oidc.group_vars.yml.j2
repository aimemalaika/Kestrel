---
# Generated by the Kestrel Kubespray add-on (prepare phase). INCLUDE these in
# your Kubespray inventory group_vars for k8s_cluster BEFORE running cluster.yml
# (copy into inventory/<cluster>/group_vars/k8s_cluster/kestrel-oidc.yml).
kube_oidc_auth: true
kube_oidc_url: "https://{{ kestrel_addon_host }}{{ kestrel_addon_dex_path }}"
kube_oidc_client_id: "{{ kestrel_addon_oidc_client_id }}"
kube_oidc_ca_file: "{{ kestrel_addon_apiserver_ca_path }}"
kube_oidc_username_claim: "{{ kestrel_addon_oidc_username_claim }}"
kube_oidc_groups_claim: "{{ kestrel_addon_oidc_groups_claim }}"
